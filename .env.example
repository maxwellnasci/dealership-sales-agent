# === LLM (opcional) ===========================================================
# Sem chave, a demo roda em modo fallback offline (determinístico). Para a
# experiência natural completa, aponte para qualquer endpoint OpenAI-compatível
# (OpenAI, DeepSeek, Ollama, etc.).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# === Roteador Jev (TypeSafe AI via OpenRouter, opcional) =====================
# Sem chave, o Jev delega 100% ao roteador clássico (fallback padrão).
# Com a chave, o roteamento usa typesafe/jev-1.14 (endpoint /api/alpha/decisions).
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# === Checkpointing ============================================================
# memory | sqlite | postgres
CHECKPOINT_BACKEND=sqlite
SQLITE_PATH=./data/checkpoints.sqlite
POSTGRES_DSN=postgresql://dealer:dealer@localhost:5432/dealership

# === Observabilidade (Langfuse, opcional) =====================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === Negócio ==================================================================
SALES_REP_NAME=o vendedor de plantão
MAX_VEHICLE_SUGGESTIONS=3

# === mxos_ldm (scoring preditivo, opcional) ===================================
# Desligado por padrão: modelo treinado em dados sintéticos.
LDM_ENABLED=false
LDM_BACKEND=auto
LDM_WEIGHTS_PATH=./data/mxos_ldm_weights.json

# === Agendador do Card Executivo (08h30, sobe com LDM_ENABLED) ================
SCHEDULER_DB_PATH=./data/scheduler.sqlite
SCHEDULER_INTERVAL_S=60
# Vazio = despacho mock (só loga). Com URL, POST JSON com o card.
SELLER_WEBHOOK_URL=
SELLER_WHATSAPP=
